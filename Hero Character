<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 340" width="800" height="340" role="img" aria-label="Animated illustration of Anjali coding with headphones and a cup of chai" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0d1117"/>
      <stop offset="1" stop-color="#2e1065"/>
    </linearGradient>
    <linearGradient id="neon" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ec4899"/>
      <stop offset="1" stop-color="#a855f7"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#e879f9" stop-opacity=".55"/>
      <stop offset="1" stop-color="#e879f9" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <style>
    text { font-family: 'Fira Code', 'Consolas', monospace; }
    .float   { animation: float 4s ease-in-out infinite; }
    .float2  { animation: float 5s ease-in-out infinite .8s; }
    .float3  { animation: float 3.5s ease-in-out infinite 1.4s; }
    .float4  { animation: float 4.5s ease-in-out infinite .3s; }
    @keyframes float { 50% { transform: translateY(-12px); } }

    .tw  { animation: tw 2.4s ease-in-out infinite; }
    .tw2 { animation: tw 3.1s ease-in-out infinite .7s; }
    .tw3 { animation: tw 2.8s ease-in-out infinite 1.5s; }
    @keyframes tw { 50% { opacity: .15; } }

    .blink { transform-box: fill-box; transform-origin: center; animation: blink 4s infinite; }
    @keyframes blink { 0%,93%,100% { transform: scaleY(1); } 96% { transform: scaleY(.08); } }

    .code { transform-box: fill-box; transform-origin: left center; animation: typing 6s ease-in-out infinite; }
    .c2 { animation-delay: .5s; } .c3 { animation-delay: 1s; } .c4 { animation-delay: 1.5s; }
    .c5 { animation-delay: 2s; } .c6 { animation-delay: 2.5s; }
    @keyframes typing { 0% { transform: scaleX(0); } 25%,85% { transform: scaleX(1); } 100% { transform: scaleX(0); } }

    .cursor { animation: cur 1s steps(1) infinite; }
    @keyframes cur { 50% { opacity: 0; } }

    .handL { animation: tap .5s ease-in-out infinite; }
    .handR { animation: tap .5s ease-in-out infinite .25s; }
    @keyframes tap { 50% { transform: translateY(3px); } }

    .steam { stroke-dasharray: 6 8; animation: steam 2.2s linear infinite; }
    .steam2 { animation-delay: .8s; }
    @keyframes steam { to { stroke-dashoffset: -28; } }

    .pulse { transform-box: fill-box; transform-origin: center; animation: pulse 2s ease-in-out infinite; }
    @keyframes pulse { 50% { transform: scale(1.25); opacity: .6; } }

    .bob { animation: bob 3s ease-in-out infinite; }
    @keyframes bob { 50% { transform: translateY(-4px); } }

    .note { animation: note 3s ease-in infinite; opacity: 0; }
    .note2 { animation-delay: 1.5s; }
    @keyframes note { 0% { transform: translate(0,0); opacity: 0; } 20% { opacity: 1; } 100% { transform: translate(18px,-40px); opacity: 0; } }
  </style>

  <!-- background -->
  <rect width="800" height="340" rx="22" fill="url(#bg)"/>
  <rect x="1.5" y="1.5" width="797" height="337" rx="21" fill="none" stroke="url(#neon)" stroke-width="2" opacity=".7"/>

  <!-- stars -->
  <g fill="#f5d0fe">
    <circle class="tw"  cx="40"  cy="40"  r="2"/>
    <circle class="tw2" cx="380" cy="28"  r="1.6"/>
    <circle class="tw3" cx="760" cy="44"  r="2.2"/>
    <circle class="tw"  cx="410" cy="300" r="1.8"/>
    <circle class="tw2" cx="30"  cy="290" r="2"/>
    <circle class="tw3" cx="770" cy="250" r="1.6"/>
    <circle class="tw"  cx="600" cy="22"  r="1.5"/>
  </g>

  <!-- holographic code screen -->
  <g class="float">
    <rect x="50" y="50" width="310" height="190" rx="14" fill="#0d1117" fill-opacity=".88" stroke="#a855f7" stroke-width="2"/>
    <circle cx="72" cy="70" r="5" fill="#ef4444"/>
    <circle cx="90" cy="70" r="5" fill="#facc15"/>
    <circle cx="108" cy="70" r="5" fill="#22c55e"/>
    <text x="205" y="74" font-size="11" fill="#c4b5fd">anjali.py</text>
    <line x1="50" y1="85" x2="360" y2="85" stroke="#a855f7" stroke-opacity=".4"/>
    <rect class="code"    x="70"  y="100" width="120" height="9" rx="4.5" fill="#ec4899"/>
    <rect class="code c2" x="90"  y="120" width="190" height="9" rx="4.5" fill="#a855f7"/>
    <rect class="code c3" x="90"  y="140" width="140" height="9" rx="4.5" fill="#e879f9"/>
    <rect class="code c4" x="110" y="160" width="170" height="9" rx="4.5" fill="#8b5cf6"/>
    <rect class="code c5" x="90"  y="180" width="100" height="9" rx="4.5" fill="#f472b6"/>
    <rect class="code c6" x="70"  y="200" width="150" height="9" rx="4.5" fill="#c084fc"/>
    <rect class="cursor" x="300" y="198" width="8" height="14" fill="#f5d0fe"/>
    <text x="70" y="228" font-size="11" fill="#86efac">&gt;&gt;&gt; build(dreams) # ✔ success</text>
  </g>

  <!-- floating tech badges -->
  <g class="float2"><circle cx="420" cy="70" r="24" fill="#1e1b4b" stroke="#ec4899" stroke-width="2"/><text x="420" y="75" font-size="14" fill="#f9a8d4" text-anchor="middle" font-weight="700">&lt;/&gt;</text></g>
  <g class="float3"><circle cx="705" cy="70" r="24" fill="#1e1b4b" stroke="#a855f7" stroke-width="2"/><text x="705" y="76" font-size="16" fill="#d8b4fe" text-anchor="middle" font-weight="700">AI</text></g>
  <g class="float4"><circle cx="740" cy="170" r="22" fill="#1e1b4b" stroke="#e879f9" stroke-width="2"/><text x="740" y="175" font-size="14" fill="#f0abfc" text-anchor="middle" font-weight="700">Py</text></g>
  <g class="float"><circle cx="425" cy="190" r="22" fill="#1e1b4b" stroke="#8b5cf6" stroke-width="2"/><text x="425" y="195" font-size="14" fill="#c4b5fd" text-anchor="middle" font-weight="700">{ }</text></g>
  <g class="float2"><circle cx="395" cy="125" r="17" fill="#1e1b4b" stroke="#f472b6" stroke-width="2"/><text x="395" y="130" font-size="11" fill="#fbcfe8" text-anchor="middle" font-weight="700">C++</text></g>

  <!-- character glow -->
  <ellipse cx="560" cy="200" rx="120" ry="110" fill="url(#glow)"/>

  <!-- music notes from headphones -->
  <text class="note"  x="630" y="110" font-size="18" fill="#f9a8d4">♪</text>
  <text class="note note2" x="500" y="100" font-size="16" fill="#d8b4fe">♫</text>

  <!-- character -->
  <g class="bob">
    <!-- hair back + bun -->
    <circle cx="560" cy="135" r="52" fill="#1f1235"/>
    <circle cx="560" cy="76" r="21" fill="#1f1235"/>
    <rect x="543" y="92" width="34" height="8" rx="4" fill="#ec4899"/>
    <!-- body (hoodie) -->
    <path d="M498 280 Q498 198 560 188 Q622 198 622 280 Z" fill="#a21caf"/>
    <path d="M540 190 Q560 215 580 190" fill="none" stroke="#f0abfc" stroke-width="3" stroke-linecap="round"/>
    <!-- neck -->
    <rect x="548" y="168" width="24" height="26" rx="8" fill="#f1b78f"/>
    <!-- face -->
    <circle cx="560" cy="136" r="42" fill="#f5c9a8"/>
    <!-- bangs -->
    <path d="M517 130 Q520 88 560 90 Q600 88 603 130 Q585 108 560 112 Q535 108 517 130 Z" fill="#1f1235"/>
    <!-- cheeks -->
    <circle cx="534" cy="152" r="7" fill="#fb7185" opacity=".45"/>
    <circle cx="586" cy="152" r="7" fill="#fb7185" opacity=".45"/>
    <!-- eyes -->
    <ellipse class="blink" cx="544" cy="138" rx="4.5" ry="6" fill="#1b1b2f"/>
    <ellipse class="blink" cx="576" cy="138" rx="4.5" ry="6" fill="#1b1b2f"/>
    <circle cx="545.5" cy="136" r="1.5" fill="#fff"/>
    <circle cx="577.5" cy="136" r="1.5" fill="#fff"/>
    <!-- glasses -->
    <circle cx="544" cy="138" r="13" fill="none" stroke="#ec4899" stroke-width="2.5"/>
    <circle cx="576" cy="138" r="13" fill="none" stroke="#ec4899" stroke-width="2.5"/>
    <line x1="557" y1="138" x2="563" y2="138" stroke="#ec4899" stroke-width="2.5"/>
    <!-- smile -->
    <path d="M549 156 Q560 167 571 156" fill="none" stroke="#9f1239" stroke-width="2.5" stroke-linecap="round"/>
    <!-- headphones -->
    <path d="M514 134 Q514 82 560 82 Q606 82 606 134" fill="none" stroke="#e879f9" stroke-width="7" stroke-linecap="round"/>
    <rect x="504" y="122" width="16" height="30" rx="8" fill="#ec4899"/>
    <rect x="600" y="122" width="16" height="30" rx="8" fill="#ec4899"/>

    <!-- laptop (back view) -->
    <rect x="488" y="236" width="144" height="58" rx="8" fill="#2a2a3d" stroke="#8b5cf6" stroke-width="2"/>
    <circle cx="560" cy="265" r="14" fill="#e879f9" opacity=".25" class="pulse"/>
    <circle cx="560" cy="265" r="7" fill="#f0abfc"/>
    <rect x="466" y="294" width="188" height="8" rx="4" fill="#4c1d95"/>
    <!-- hands -->
    <circle class="handL" cx="516" cy="244" r="9" fill="#f5c9a8"/>
    <circle class="handR" cx="604" cy="244" r="9" fill="#f5c9a8"/>
  </g>

  <!-- desk -->
  <rect x="400" y="302" width="380" height="12" rx="6" fill="#3b0764"/>
  <rect x="400" y="302" width="380" height="3" rx="1.5" fill="#a855f7" opacity=".6"/>

  <!-- chai cup -->
  <g>
    <rect x="698" y="270" width="30" height="32" rx="6" fill="#fde68a"/>
    <path d="M728 280 q12 0 12 10 q0 10 -12 10" fill="none" stroke="#fde68a" stroke-width="4"/>
    <rect x="698" y="270" width="30" height="7" rx="3" fill="#b45309"/>
    <path class="steam"  d="M706 262 q-6 -10 0 -18 q6 -8 0 -16" fill="none" stroke="#f5d0fe" stroke-width="2.5" stroke-linecap="round"/>
    <path class="steam steam2" d="M720 262 q-6 -10 0 -18 q6 -8 0 -16" fill="none" stroke="#f5d0fe" stroke-width="2.5" stroke-linecap="round"/>
  </g>

  <!-- caption -->
  <text x="400" y="330" font-size="12" fill="#d8b4fe" text-anchor="middle" opacity=".9">Code. Eat. Sleep. Repeat. ☕</text>
</svg>
